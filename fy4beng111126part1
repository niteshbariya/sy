function toggleDarkMode() {
    document.body.classList.toggle("dark-mode");
    const isDark = document.body.classList.contains("dark-mode");
    const btn = document.getElementById("themeToggleBtn");
    btn.innerHTML = isDark ? '<i class="fa-solid fa-sun"></i> લાઈટ મોડ' : '<i class="fa-solid fa-moon"></i> ડાર્ક મોડ';
}

function showNotice(msg, type = "info") {
    const box = document.getElementById("noticeMsg");
    box.className = "msg-box " + (type === "error" ? "msg-error" : "msg-info");
    box.innerText = msg;
    box.style.display = "block";
    setTimeout(() => { box.style.display = "none"; }, 6000);
}

function requestOTP() {
    studentName = document.getElementById("name").value.trim();
    studentPhone = document.getElementById("phone").value.trim();
    studentEmail = document.getElementById("email").value.trim();

    if (!studentName || studentPhone.length < 10 || !studentEmail.includes("@")) {
        showNotice("કૃપા કરીને પૂરું નામ, ૧૦ અંકનો સાચો મોબાઇલ નંબર અને માન્ય ઇમેઇલ દાખલ કરો.", "error");
        return;
    }

    const btn = document.getElementById("getOtpBtn");
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> OTP મોકલાઈ રહ્યો છે...';

    fetch(SCRIPT_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "text/plain" },
        body: JSON.stringify({
            action: "sendOTP",
            name: studentName,
            email: studentEmail
        })
    })
    .then(function() {
        showNotice("આપના ઈમેઈલ પર ૪ અંકનો OTP મોકલવામાં આવ્યો છે. ઇનબોક્સ/સ્પામ તપાસો.", "info");
        document.getElementById("otpContainer").style.display = "block";
        btn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> OTP ફરીથી મોકલો';
        btn.disabled = false;
    })
    .catch(function() {
        showNotice("OTP મોકલવામાં ક્ષતિ આવી. ફરી પ્રયાસ કરો.", "error");
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> OTP મેળવો અને આગળ વધો';
    });
}

function verifyAndStart() {
    const enteredOTP = document.getElementById("otpInput").value.trim();
    if (enteredOTP.length !== 4) {
        showNotice("કૃપા કરીને ૪ અંકનો સાચો OTP દાખલ કરો.", "error");
        return;
    }

    const vBtn = document.getElementById("verifyBtn");
    vBtn.disabled = true;
    vBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> ચકાસણી ચાલુ છે...';

    fetch(SCRIPT_URL, {
        method: "POST",
        body: JSON.stringify({
            action: "verifyOTP",
            email: studentEmail,
            otp: enteredOTP
        })
    })
    .then(res => res.json())
    .then(data => {
        if (data.status === "success" && data.verified) {
            document.getElementById("loginScreen").style.display = "none";
            document.getElementById("quizScreen").style.display = "block";
            initQuestionPalette();
            startTime = new Date();
            timerInterval = setInterval(updateTimer, 1000);
            loadQuestion();
        } else {
            showNotice("ખોટો OTP અથવા સમય વીતી ગયો છે! ફરી ચકાસો.", "error");
            vBtn.disabled = false;
            vBtn.innerHTML = '<i class="fa-solid fa-unlock-keyhole"></i> OTP ચકાસો અને મોક ટેસ્ટ શરૂ કરો';
        }
    })
    .catch(() => {
        showNotice("ચકાસણીમાં ભૂલ થઈ. ફરી પ્રયાસ કરો.", "error");
        vBtn.disabled = false;
        vBtn.innerHTML = '<i class="fa-solid fa-unlock-keyhole"></i> OTP ચકાસો અને મોક ટેસ્ટ શરૂ કરો';
    });
}

function updateTimer() {
    const elapsed = Math.floor((new Date() - startTime) / 1000);
    const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
    const secs = String(elapsed % 60).padStart(2, '0');
    document.getElementById("timerDisplay").innerText = `${mins}:${secs}`;
}

function initQuestionPalette() {
    const container = document.getElementById("questionGridContainer");
    container.innerHTML = "";
    for (let i = 0; i < questions.length; i++) {
        const pill = document.createElement("div");
        pill.className = "q-pill";
        pill.id = `qPill_${i}`;
        pill.innerText = i + 1;
        pill.onclick = () => jumpToQuestion(i);
        container.appendChild(pill);
    }
    updatePaletteStats();
}

function updatePaletteStats() {
    let answered = 0;
    for (let i = 0; i < questions.length; i++) {
        const pill = document.getElementById(`qPill_${i}`);
        if (!pill) continue;
        pill.className = "q-pill";
        
        if (i === currentQ) {
            pill.classList.add("status-current");
        }
        if (flaggedQuestions[i]) {
            pill.classList.add("status-flagged");
        } else if (userAnswers[i] !== null) {
            pill.classList.add("status-answered");
            answered++;
        }
    }
    const totalAns = userAnswers.filter(a => a !== null).length;
    document.getElementById("answeredCountBadge").innerText = `${totalAns} / ${questions.length} પૂર્ણ`;
}

function jumpToQuestion(idx) {
    currentQ = idx;
    loadQuestion();
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function loadQuestion() {
    const q = questions[currentQ];
    document.getElementById("qProgress").innerText = `પ્રશ્ન ${currentQ + 1} / ${questions.length}`;
    document.getElementById("unitBadge").innerText = `📘 ${q.unit}`;
    document.getElementById("questionText").innerText = q.q;

    const flagBtn = document.getElementById("flagBtn");
    if (flaggedQuestions[currentQ]) {
        flagBtn.className = "btn-flag active-flag";
        flagBtn.innerHTML = '<i class="fa-solid fa-bookmark"></i> Flag કરેલ છે 🚩';
    } else {
        flagBtn.className = "btn-flag";
        flagBtn.innerHTML = '<i class="fa-regular fa-bookmark"></i> Flag (રિવ્યુ માટે)';
    }

    const optContainer = document.getElementById("optionsContainer");
    optContainer.innerHTML = "";

    q.options.forEach((opt, idx) => {
        const label = document.createElement("label");
        label.className = "option-label";
        const isChecked = userAnswers[currentQ] === idx ? "checked" : "";
        label.innerHTML = `
            <input type="radio" name="opt" value="${idx}" ${isChecked} onchange="onOptionSelect(${idx})">
            <span><strong>(${String.fromCharCode(65 + idx)})</strong> ${opt}</span>
        `;
        optContainer.appendChild(label);
    });

    document.getElementById("prevBtn").style.visibility = (currentQ === 0) ? "hidden" : "visible";
    document.getElementById("nextBtn").innerHTML = (currentQ === questions.length - 1) 
        ? '<i class="fa-solid fa-flag-checkered"></i> કસોટી પૂર્ણ કરો' 
        : 'આગળ <i class="fa-solid fa-arrow-right"></i>';

    updatePaletteStats();
}

function onOptionSelect(idx) {
    userAnswers[currentQ] = idx;
    updatePaletteStats();
}

function toggleFlagCurrentQuestion() {
    flaggedQuestions[currentQ] = !flaggedQuestions[currentQ];
    loadQuestion();
}

function prevQuestion() {
    if (currentQ > 0) {
        currentQ--;
        loadQuestion();
    }
}

function nextQuestion() {
    if (currentQ < questions.length - 1) {
        currentQ++;
        loadQuestion();
    } else {
        confirmSubmitQuiz();
    }
}

function confirmSubmitQuiz() {
    const unans = userAnswers.filter(a => a === null).length;
    const flagCount = flaggedQuestions.filter(f => f === true).length;
    
    let msg = "શું આપ ખરેખર કસોટી સબમિટ કરવા માંગો છો?";
    if (unans > 0 || flagCount > 0) {
        msg = `ધ્યાન આપો:\n- ${unans} પ્રશ્નોના ઉત્તર બાકી છે.\n- ${flagCount} પ્રશ્નો Flag કરેલા છે.\n\nશું આપ કસોટી સબમિટ કરવા માંગો છો?`;
    }
    
    if (confirm(msg)) {
        submitQuiz();
    }
}

function submitQuiz() {
    clearInterval(timerInterval);
    const elapsed = Math.floor((new Date() - startTime) / 1000);
    const mins = Math.floor(elapsed / 60);
    const secs = elapsed % 60;
    const formattedTime = `${mins} મિનિટ ${secs} સેકન્ડ`;

    let score = 0;
    let wrongIndices = [];
    questions.forEach((q, i) => {
        if (userAnswers[i] === q.ans) {
            score++;
        } else {
            wrongIndices.push(i);
        }
    });
    const percent = ((score / questions.length) * 100).toFixed(2);
    const flagCount = flaggedQuestions.filter(f => f === true).length;

    document.getElementById("quizScreen").style.display = "none";
    document.getElementById("resultScreen").style.display = "block";

    document.getElementById("resName").innerText = studentName;
    document.getElementById("resPhone").innerText = studentPhone;
    document.getElementById("resTime").innerText = `${mins}m ${secs}s`;
    document.getElementById("resScore").innerText = `${score} / ${questions.length}`;
    document.getElementById("resPercent").innerText = `${percent}% ગુણાંક`;
    document.getElementById("resCorrectCount").innerText = score;
    document.getElementById("resWrongCount").innerText = questions.length - score;
    document.getElementById("resFlagCount").innerText = flagCount;

    renderWrongQuestions(wrongIndices);
    renderFullAnswerKey();
    renderBlankPaper();
    prepareAndSendBackendResult(score, percent, formattedTime);
}

function switchResultTab(tabName) {
    document.getElementById("tabBtnWrong").classList.remove("active-tab");
    document.getElementById("tabBtnAnswers").classList.remove("active-tab");
    document.getElementById("tabBtnBlank").classList.remove("active-tab");

    document.getElementById("tabContentWrong").style.display = "none";
    document.getElementById("tabContentAnswers").style.display = "none";
    document.getElementById("tabContentBlank").style.display = "none";

    if (tabName === "wrong") {
        document.getElementById("tabBtnWrong").classList.add("active-tab");
        document.getElementById("tabContentWrong").style.display = "block";
    } else if (tabName === "answers") {
        document.getElementById("tabBtnAnswers").classList.add("active-tab");
        document.getElementById("tabContentAnswers").style.display = "block";
    } else if (tabName === "blank") {
        document.getElementById("tabBtnBlank").classList.add("active-tab");
        document.getElementById("tabContentBlank").style.display = "block";
    }
}

function renderWrongQuestions(wrongIndices) {
    const container = document.getElementById("wrongQuestionsList");
    container.innerHTML = "";

    if (wrongIndices.length === 0) {
        container.innerHTML = `
            <div style="text-align: center; padding: 35px; background: var(--container-bg); border-radius: 12px; border: 2px solid #10b981;">
                <i class="fa-solid fa-circle-check fa-3x" style="color: #10b981; margin-bottom: 12px;"></i>
                <h3 style="color: #065f46; font-size: 18px;">અભિનંદન! તમારો એક પણ પ્રશ્ન ખોટો પડ્યો નથી!</h3>
                <p style="color: var(--subheading-color); font-size: 13.5px; margin-top: 6px;">આપે ૧૦૦ માંથી ૧૦૦ સંપૂર્ણ ગુણ મેળવી શ્રેષ્ઠ પ્રદર્શન કરેલ છે.</p>
            </div>
        `;
        return;
    }

    wrongIndices.forEach((i) => {
        const q = questions[i];
        const userChoiceText = userAnswers[i] !== null ? q.options[userAnswers[i]] : "જવાબ આપ્યો નથી (ખાલી છોડેલ)";
        const correctChoiceText = q.options[q.ans];

        const item = document.createElement("div");
        item.className = "review-item is-wrong";
        item.innerHTML = `
            <p style="font-weight: 800; font-size: 15px; margin-bottom: 8px;">${q.q}</p>
            <p style="margin: 4px 0; font-weight: 700; color: #b91c1c;">❌ તમારો ઉત્તર: ${userChoiceText}</p>
            <p style="margin: 4px 0; font-weight: 700; color: #047857;">✅ સાચો ઉત્તર: <strong>(${String.fromCharCode(65 + q.ans)}) ${correctChoiceText}</strong></p>
            <div class="exp-box">
                <div style="font-size: 11.5px; font-weight: 800; color: #2563eb; margin-bottom: 3px;">📘 ${q.unit}</div>
                <strong>વિગતવાર સમજૂતી:</strong> ${q.exp}
            </div>
        `;
        container.appendChild(item);
    });
}

function renderFullAnswerKey() {
    const container = document.getElementById("allAnswersList");
    container.innerHTML = "";

    questions.forEach((q, i) => {
        const isCorrect = (userAnswers[i] === q.ans);
        const userChoiceText = userAnswers[i] !== null ? q.options[userAnswers[i]] : "જવાબ આપ્યો નથી";
        const correctChoiceText = q.options[q.ans];

        const item = document.createElement("div");
        item.className = "review-item " + (isCorrect ? "is-correct" : "is-wrong");
        item.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:6px;">
                <span style="font-weight: 800; font-size: 15px;">${q.q}</span>
                <span style="font-size: 12px; font-weight: 800; padding: 2px 8px; border-radius: 6px; background:${isCorrect ? '#10b981' : '#ef4444'}; color:white; white-space:nowrap;">
                    ${isCorrect ? '✅ સાચો' : '❌ ખોટો'}
                </span>
            </div>
            <div style="margin: 6px 0; font-size: 13.5px;">
                ${q.options.map((opt, oIdx) => `
                    <div style="padding: 2px 0; ${oIdx === q.ans ? 'font-weight:bold; color:#047857;' : ''}">
                        (${String.fromCharCode(65 + oIdx)}) ${opt} ${oIdx === q.ans ? '⭐ (સાચો ઉત્તર)' : ''}
                    </div>
                `).join('')}
            </div>
            <p style="margin: 6px 0; font-weight: 700;">
                તમે પસંદ કરેલ જવાબ: <span style="color:${isCorrect ? '#047857' : '#b91c1c'};">${userChoiceText}</span>
            </p>
            <div class="exp-box">
                <div style="font-size: 11.5px; font-weight: 800; color: #2563eb; margin-bottom: 3px;">📘 ${q.unit}</div>
                <strong>સમજૂતી:</strong> ${q.exp}
            </div>
        `;
        container.appendChild(item);
    });
}

function renderBlankPaper() {
    const container = document.getElementById("blankQuestionsList");
    container.innerHTML = `
        <div style="background: var(--card-gradient); padding: 14px; border-radius: 10px; margin-bottom: 14px; border: 1.5px solid var(--border-color); text-align: center;">
            <h3 style="color: var(--heading-color); font-size: 16px; font-weight: 800;">📝 મૂળ પ્રશ્નપત્ર (Offline / Practice View)</h3>
            <p style="color: var(--subheading-color); font-size: 12.5px;">આ પ્રશ્નપત્રમાં કોઈપણ જવાબ ટીક કરેલ નથી. તમે સ્વ-અધ્યયન કે પુનરાવર્તન માટે તેનો ઉપયોગ કરી શકો છો.</p>
        </div>
    `;

    questions.forEach((q, i) => {
        const box = document.createElement("div");
        box.className = "blank-q-card";
        box.innerHTML = `
            <div style="font-weight: 800; font-size: 14.5px; margin-bottom: 8px; color: var(--heading-color);">${q.q}</div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px; font-size: 13.5px; color: var(--text-color);">
                ${q.options.map((opt, oIdx) => `
                    <div style="background: var(--option-bg); padding: 7px 10px; border-radius: 6px; border: 1px solid var(--border-color);">
                        <strong>(${String.fromCharCode(65 + oIdx)})</strong> ${opt}
                    </div>
                `).join('')}
            </div>
        `;
        container.appendChild(box);
    });
}

function prepareAndSendBackendResult(score, percent, formattedTime) {
    let emailReviewHtml = "";
    
    questions.forEach((q, i) => {
        const isCorrect = (userAnswers[i] === q.ans);
        const userChoiceText = userAnswers[i] !== null ? q.options[userAnswers[i]] : "જવાબ આપ્યો નથી";
        const correctChoiceText = q.options[q.ans];

        emailReviewHtml += `
            <div style="border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px; margin-bottom: 12px; background-color: ${isCorrect ? '#f0fdf4' : '#fff1f2'};">
                <p style="margin: 0 0 6px 0; font-weight: bold; color: #1e293b;">${q.q}</p>
                <p style="margin: 3px 0; color: ${isCorrect ? '#166534' : '#9f1239'};">
                    <strong>પરીક્ષાર્થીનો ઉત્તર:</strong> ${userChoiceText} ${isCorrect ? '✅' : '❌'}
                </p>
                ${!isCorrect ? `<p style="margin: 3px 0; color: #166534; font-weight: bold;"><strong>સાચો ઉત્તર:</strong> (${String.fromCharCode(65 + q.ans)}) ${correctChoiceText}</p>` : ''}
                <div style="background-color: #f8fafc; padding: 8px; border-radius: 4px; margin-top: 6px; font-size: 12.5px; border-left: 3px solid #2563eb;">
                    <div style="color: #1e40af; font-weight: bold; margin-bottom: 2px;">📘 ${q.unit}</div>
                    <strong>સમજૂતી:</strong> ${q.exp}
                </div>
            </div>
        `;
    });

    fetch(SCRIPT_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "text/plain" },
        body: JSON.stringify({
            action: "submitResult",
            dateTime: new Date().toLocaleString('gu-IN', { timeZone: 'Asia/Kolkata' }),
            name: studentName,
            phone: studentPhone,
            email: studentEmail,
            timeTaken: formattedTime,
            score: `${score} / ${questions.length}`,
            percentage: `${percent}%`,
            subject: "GCERT D.El.Ed. કોર્સ-૪(બ): અંગ્રેજીમાં પ્રાવીણ્ય સજ્જતા (૧૦૦ HOTS)",
            detailedReviewHtml: emailReviewHtml,
            repoName: "english_stage1",
            testFileName: "tet_tat_class2_english.html",
            testUploadDate: new Date().toISOString().slice(0, 10)
        })
    });
}
</script>
</body>
